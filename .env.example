# ==============================================================================
# SANAD (سند) — Environment Configuration Template
# Copy this file to .env and adjust values for your local or production deployment.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Connection (Neon / PostgreSQL)
# Connection pool string supporting SSL mode
DATABASE_URL=postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Default System Administrator Account (Seeded on first migration)
ADMIN_EMAIL=admin@sanad.com
ADMIN_PASSWORD=Sanad@2026

# Session & Security Settings
SESSION_SECRET=sanad_secure_session_secret_key_change_in_production_2026
MFA_ENCRYPTION_KEY=pl3L1FUaG5w+IokX0NpcGXFwJSbRb6ErXpnUtD4/LSk=

# Email Delivery Configuration
# Options: 'console' (prints verification link to terminal) or 'smtp' (delivers via SMTP)
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@sanad.org

# SMTP Credentials (Required only when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# AI Integration (Optional)
# Google Gemini API key for Phase 7 AI-Assisted Case Note Extraction
# If omitted or unavailable, SANAD automatically falls back to its deterministic Arabic NLP heuristic parser
GEMINI_API_KEY=
