<%
    var _cp = typeof currentPath !== 'undefined' ? currentPath : '';
    function _activeAttr(href) {
        var path = href.split('#')[0];
        return _cp === path ? ' active" aria-current="page' : '"';
    }
%>
<script>
    (() => {
        try {
            const user = JSON.parse(localStorage.getItem("sanadUser") || "null");
            if (user?.role === "admin") {
                document.documentElement.classList.add("role-admin");
                if (document.body) document.body.classList.add("role-admin");
            }
        } catch { }
    })();
</script>
<div class="admin-topbar" id="adminTopbar" role="region" aria-label="شريط الإدارة">
    <div class="admin-topbar-start">
        <button type="button" class="btn btn-outline admin-sidebar-toggle" id="adminSidebarToggle"
            aria-expanded="false" aria-controls="adminSidebar">
            <i class="fa-solid fa-bars" aria-hidden="true"></i> قائمة الإدارة
        </button>
    </div>
    <div class="admin-topbar-end">
        <div class="nav-notifications-wrapper" id="navNotificationsWrapper">
            <button type="button" class="btn btn-outline nav-notification-btn" id="headerNotificationBtn" aria-label="الإشعارات والتنبيهات" aria-expanded="false" title="التنبيهات التشغيلية">
                <i class="fa-solid fa-bell" aria-hidden="true"></i>
                <span class="notification-badge" id="notificationBadge" hidden>0</span>
            </button>
            <div class="notification-dropdown" id="headerNotificationDropdown" role="region" aria-label="قائمة التنبيهات التشغيلية" hidden>
                <div class="notif-dropdown-header">
                    <div class="notif-header-title">
                        <i class="fa-solid fa-bell" aria-hidden="true"></i>
                        <span>التنبيهات التشغيلية</span>
                    </div>
                    <button type="button" class="notif-mark-read" id="notifMarkAllRead">تحديد كمقروء</button>
                </div>
                <div class="notif-dropdown-body" id="notificationsList">
                    <div class="notif-empty">لا توجد تنبيهات جديدة حالياً</div>
                </div>
                <div class="notif-dropdown-footer">
                    <a href="/dashboard" class="notif-footer-link">لوحة البيانات <i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a>
                </div>
            </div>
        </div>
        <a href="/profile" class="admin-topbar-name" id="adminUserName" title="الملف الشخصي">
            <i class="fa-solid fa-user-shield" aria-hidden="true"></i><span>المشرف</span>
        </a>
        <a href="/login" class="admin-topbar-logout" data-logout title="تسجيل الخروج">
            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i><span>تسجيل الخروج</span>
        </a>
    </div>
</div>
<script src="/JS/navbar-auth.js" defer></script>
<script src="/JS/header-notifications.js" defer></script>
<div class="admin-layout" id="adminLayout">
    <aside class="admin-sidebar" id="adminSidebar" aria-label="قائمة الإدارة">
        <button type="button" class="admin-sidebar-collapse" id="adminSidebarCollapse"
            aria-label="طي القائمة الجانبية" aria-expanded="true">
            <i class="fa-solid fa-angles-right" aria-hidden="true"></i><span>طي القائمة</span>
        </button>
        <div class="admin-theme-control" data-theme-host aria-label="إعدادات المظهر"></div>
        <nav class="admin-sidebar-nav" aria-label="روابط لوحة الإدارة">
            <a class="admin-sidebar-link<%- _activeAttr('/dashboard') %>" href="/dashboard"><i class="fa-solid fa-gauge-high"
                    aria-hidden="true"></i><span>لوحة البيانات</span></a>
            <a class="admin-sidebar-link<%- _activeAttr('/inventory') %>" href="/inventory"><i class="fa-solid fa-boxes-stacked"
                    aria-hidden="true"></i><span>المخزون</span></a>
            <a class="admin-sidebar-link<%- _activeAttr('/verification') %>" href="/verification"><i class="fa-solid fa-shield-halved"
                    aria-hidden="true"></i><span>التحقق</span></a>
            <a class="admin-sidebar-link<%- _activeAttr('/verification') %>" href="/verification#recommendations"><i class="fa-solid fa-lightbulb"
                    aria-hidden="true"></i><span>التوصيات</span></a>
            <a class="admin-sidebar-link<%- _activeAttr('/distributions') %>" href="/distributions"><i class="fa-solid fa-truck-fast"
                    aria-hidden="true"></i><span>التوزيعات</span></a>
            <a class="admin-sidebar-link<%- _activeAttr('/admin-requests') %>" href="/admin-requests"><i class="fa-solid fa-users-gear"
                    aria-hidden="true"></i><span>الإدارة</span></a>
            <a class="admin-sidebar-link<%- _activeAttr('/beneficiaries') %>" href="/beneficiaries"><i class="fa-solid fa-people-roof"
                    aria-hidden="true"></i><span>المستفيدون</span></a>
        </nav>
    </aside>
    <button type="button" class="admin-sidebar-overlay" id="adminSidebarOverlay"
        aria-label="إغلاق قائمة الإدارة"></button>
    <div class="admin-main">
