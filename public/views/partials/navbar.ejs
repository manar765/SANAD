<script>
    (() => {
        try {
            const user = JSON.parse(localStorage.getItem("sanadUser") || "null");
            if (user?.role === "admin") {
                document.documentElement.classList.add("role-admin");
            }
        } catch { }
    })();
</script>
<header class="navbar" id="navbar">
    <div class="container nav-inner">
        <a href="/" class="brand" aria-label="سند — الصفحة الرئيسية">
            <img src="/assets/images/LogoSANAD.png" alt="شعار سند" class="brand-logo" />
            <span class="brand-text">
                <span class="brand-ar">سند</span>
                <span class="brand-en">SANAD</span>
            </span>
        </a>

        <nav class="nav-menu" id="navMenu" aria-label="التنقل الرئيسي">
            <div class="nav-links">
                <% if (activePath==='/' ) { %>
                    <a href="#home" class="nav-link active">الرئيسية</a>
                    <a href="/dashboard" class="nav-link" data-role="admin">لوحة البيانات</a>
                    <a href="#about" class="nav-link">عن سند</a>
                    <a href="/donations" class="nav-link">التبرعات</a>
                    <a href="/inventory" class="nav-link" data-role="admin">المخزون</a>
                    <a href="/beneficiaries" class="nav-link" data-role="admin">المستفيدون</a>
                    <a href="/verification" class="nav-link" data-role="admin">التحقق والتوصيات</a>
                    <a href="/distributions" class="nav-link" data-role="admin">التوزيعات</a>
                    <a href="#contact" class="nav-link">تواصل معنا</a>
                    <% } else { %>
                        <a href="/" class="nav-link">الرئيسية</a>
                        <a href="/dashboard" class="nav-link <%= activePath === '/dashboard' ? 'active' : '' %>"
                            data-role="admin">لوحة
                            البيانات</a>
                        <a href="/donations"
                            class="nav-link <%= activePath === '/donations' ? 'active' : '' %>">التبرعات</a>
                        <a href="/inventory" class="nav-link <%= activePath === '/inventory' ? 'active' : '' %>"
                            data-role="admin">المخزون</a>
                        <a href="/beneficiaries" class="nav-link <%= activePath === '/beneficiaries' ? 'active' : '' %>"
                            data-role="admin">المستفيدون</a>
                        <a href="/verification" class="nav-link <%= activePath === '/verification' ? 'active' : '' %>"
                            data-role="admin">التحقق والتوصيات</a>
                        <a href="/distributions" class="nav-link <%= activePath === '/distributions' ? 'active' : '' %>"
                            data-role="admin">التوزيعات</a>
                        <a href="/admin-requests"
                            class="nav-link <%= activePath === '/admin-requests' ? 'active' : '' %>"
                            data-role="admin">الإدارة</a>
                        <a href="/#contact" class="nav-link">تواصل معنا</a>
                        <% } %>
            </div>

            <div class="nav-actions">
                <div class="guest-actions" id="guestActions">
                    <a href="/login" class="btn btn-outline">تسجيل دخول</a>
                    <a href="/signup" class="btn btn-primary">إنشاء حساب</a>
                </div>
                <div class="user-actions hidden" id="userActions" aria-live="polite">
                    <div class="nav-notifications-wrapper" id="navNotificationsWrapper">
                        <button type="button" class="btn btn-outline nav-notification-btn" id="headerNotificationBtn" aria-label="الإشعارات والتنبيهات" aria-expanded="false" title="التنبيهات التشغيلية">
                            <i class="fa-solid fa-bell" aria-hidden="true"></i>
                            <span class="notification-badge" id="notificationBadge" hidden>0</span>
                        </button>
                        <div class="notification-dropdown" id="headerNotificationDropdown" role="region" aria-label="قائمة التنبيهات التشغيلية" hidden>
                            <div class="notif-dropdown-header">
                                <div class="notif-header-title">
                                    <i class="fa-solid fa-bell" aria-hidden="true"></i>
                                    <span>التنبيهات التشغيلية</span>
                                </div>
                                <button type="button" class="notif-mark-read" id="notifMarkAllRead">تحديد كمقروء</button>
                            </div>
                            <div class="notif-dropdown-body" id="notificationsList">
                                <div class="notif-empty">لا توجد تنبيهات جديدة حالياً</div>
                            </div>
                            <div class="notif-dropdown-footer">
                                <a href="/dashboard" class="notif-footer-link">لوحة البيانات <i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a>
                            </div>
                        </div>
                    </div>
                    <span class="user-greeting">أهلاً، <strong id="homeUserName">صديق سند</strong></span>
                    <a href="/profile" class="btn btn-outline avatar-action" aria-label="فتح الملف الشخصي"
                        title="الملف الشخصي">
                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                    </a>
                    <a href="/login" class="btn btn-logout logout-action" data-logout>
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> تسجيل خروج
                    </a>
                </div>
            </div>
        </nav>

        <button class="nav-toggle" id="navToggle" aria-label="فتح القائمة" aria-expanded="false"
            aria-controls="navMenu">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    </div>
    <script src="/JS/navbar-auth.js" defer></script>
    <script src="/JS/header-notifications.js" defer></script>
</header>