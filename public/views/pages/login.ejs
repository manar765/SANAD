<!DOCTYPE html>
<% /* EJS page template */ %>
    <html lang="ar" dir="rtl">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>سند — تسجيل الدخول</title>
        <link rel="icon" type="image/png" href="/assets/images/LogoSANAD.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="stylesheet" href="/CSS/login.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

        <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap"
            rel="stylesheet">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/feather-icons/4.29.0/feather.min.js"></script>
    </head>

    <body>

        <div class="page">

            <!-- left brand panel -->
            <div class="brand-panel">
                <div class="brand-logo">
                    <img src="/assets/images/LogoSANAD.png" alt="Sanad Logo">
                </div>
                <h2>نظّم التبرعات، و وصل الخير لمستحقيه</h2>
                <p class="lead">منصة متكاملة لإدارة التبرعات العينية للمبادرات والجمعيات الخيرية.</p>
                <div class="stat-row">
                    <div>
                        <div class="num">2,450+</div>
                        <div class="label">متبرع</div>
                    </div>
                    <div>
                        <div class="num">1,250+</div>
                        <div class="label">مستفيد</div>
                    </div>
                    <div>
                        <div class="num">85+</div>
                        <div class="label">جمعية</div>
                    </div>
                </div>
            </div>

            <!-- right form panel -->
            <div class="form-panel">
                <div class="form-box">
                    <div class="top-badge"><svg data-feather="shield"></svg>دخول آمن ومشفّر</div>

                    <h3>تسجيل الدخول</h3>
                    <p class="sub">أدخل بياناتك للوصول إلى لوحة التحكم</p>

                    <form id="loginForm" novalidate>

                        <div class="field-group">
                            <label class="field-label" for="email">البريد الإلكتروني</label>
                            <input class="field" id="email" name="email" type="email"
                                placeholder="name@organization.com" autocomplete="email">
                            <div class="error-msg" id="emailError">من فضلك أدخل بريد إلكتروني صحيح</div>
                        </div>

                        <div class="field-group">
                            <label class="field-label" for="password">كلمة المرور</label>
                            <div class="input-wrap">
                                <input class="field has-icon" id="password" name="password" type="password"
                                    placeholder="••••••••" autocomplete="current-password">
                                <button type="button" class="toggle-pass" id="togglePass"
                                    aria-label="إظهار كلمة المرور">
                                    <svg data-feather="eye"></svg>
                                </button>
                            </div>
                            <div class="error-msg" id="passwordError">كلمة المرور مطلوبة</div>
                        </div>

                        <div class="row-between">
                            <label class="remember-label">
                                <input type="checkbox" id="remember">
                                تذكرني
                            </label>
                            <a class="forgot-link" href="/forgot-password">نسيت كلمة المرور؟</a>
                        </div>

                        <div class="unverified-alert" id="unverifiedAlert"
                            style="display: none; margin: 1rem 0; padding: 0.85rem; border-radius: 10px; text-align: start;">
                            <p style="font-size: 0.9rem; font-weight: 700; margin-bottom: 0.5rem;" id="unverifiedMsg">
                                بريدك الإلكتروني بحاجة إلى تفعيل قبل تسجيل الدخول.
                            </p>
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                <a id="goToVerifyBtn" href="/verify-email" class="btn btn-primary btn-sm"
                                    style="text-decoration: none;">تفعيل الحساب الآن</a>
                                <button type="button" id="loginResendBtn" class="btn btn-warning btn-sm"
                                    style="cursor: pointer;">إعادة إرسال الرمز</button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <span class="btn-text">تسجيل الدخول</span>
                            <span class="spinner"></span>
                        </button>
                    </form>
                    <form id="mfaLoginForm" class="mfa-login-form" hidden novalidate>
                        <p class="sub">أدخل الرمز الظاهر في تطبيق المصادقة، أو استخدم رمز استرداد.</p>
                        <div class="field-group">
                            <label class="field-label" for="mfaLoginCode">رمز المصادقة</label>
                            <input class="field" id="mfaLoginCode" inputmode="numeric" autocomplete="one-time-code"
                                maxlength="12" required>
                            <div class="error-msg" id="mfaLoginError"></div>
                        </div>
                        <button type="submit" class="btn btn-primary" id="mfaLoginSubmit">تأكيد الرمز</button>
                    </form>

                    <p class="signup-line">لا يوجد حساب؟ <a href="/signup">إنشاء حساب جديد</a></p>

                </div>
            </div>

        </div>
        <script src="/JS/login.js"></script>

        <script src="/JS/preferences.js"></script>
    </body>

    </html>