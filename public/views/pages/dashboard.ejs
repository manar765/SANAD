<!doctype html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>سند — لوحة التحكم التشغيلية والتقارير</title>
  <link rel="icon" type="image/png" href="/assets/images/LogoSANAD.png">
  <link rel="stylesheet" href="/CSS/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body class="dashboard-page">
  <a class="skip-link" href="#main-content">تخطي إلى المحتوى الرئيسي</a>
  <%- include('../partials/navbar', { activePath: '/dashboard' }) %>

    <main id="main-content" class="dashboard-main">
      <div class="container dashboard-container">

        <!-- Dashboard Header -->
        <header class="dashboard-heading">
          <div>
            <span class="eyebrow"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i> لوحة التحكم المركزية</span>
            <h1>نظرة تشغيلية شاملة</h1>
            <p>تابع حركة المخزون، والمستفيدين، والتوزيعات الميدانية، وسجل الرقابة من منصة موحدة.</p>
          </div>
          <div class="dashboard-head-actions">
            <button class="btn btn-outline dashboard-refresh" id="dashboardRefresh" type="button"
              aria-label="تحديث البيانات">
              <i class="fa-solid fa-rotate" aria-hidden="true"></i> تحديث البيانات
            </button>
          </div>
        </header>

        <!-- Feedback States -->
        <div id="dashboardLoading" class="dashboard-state" role="status">جارٍ تحميل بيانات اللوحة والمؤشرات…</div>
        <div id="dashboardError" class="dashboard-state error-state" role="alert" hidden>تعذر تحميل بيانات اللوحة.</div>

        <!-- 5 Primary Executive KPIs -->
        <section class="dashboard-kpis" aria-label="المؤشرات التشغيلية الرئيسية">

          <!-- KPI 1: Donations -->
          <article class="dashboard-kpi">
            <span class="kpi-icon kpi-green"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i></span>
            <div>
              <strong id="kpiDonations">—</strong>
              <span>إجمالي التبرعات</span>
              <small id="kpiDonationUnits" class="kpi-subtext">— وحدة مسجلة</small>
            </div>
          </article>

          <!-- KPI 2: Available Inventory -->
          <article class="dashboard-kpi">
            <span class="kpi-icon kpi-mint"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></span>
            <div>
              <strong id="kpiAvailable">—</strong>
              <span>المخزون المتاح</span>
              <small id="kpiTotalUnits" class="kpi-subtext">من إجمالي — وحدة</small>
            </div>
          </article>

          <!-- KPI 3: Beneficiaries -->
          <article class="dashboard-kpi">
            <span class="kpi-icon kpi-blue"><i class="fa-solid fa-users" aria-hidden="true"></i></span>
            <div>
              <strong id="kpiBeneficiaries">—</strong>
              <span>المستفيدين المسجلين</span>
              <small id="kpiVerifiedCount" class="kpi-subtext">— معتمد ومحقق</small>
            </div>
          </article>

          <!-- KPI 4: Distributions -->
          <article class="dashboard-kpi">
            <span class="kpi-icon kpi-orange"><i class="fa-solid fa-truck-ramp-box" aria-hidden="true"></i></span>
            <div>
              <strong id="kpiDistributions">—</strong>
              <span>التوزيعات المنفذة</span>
              <small id="kpiDistRate" class="kpi-subtext">نسبة الإنجاز: —%</small>
            </div>
          </article>

          <!-- KPI 5: Urgent Needs -->
          <article class="dashboard-kpi">
            <span class="kpi-icon kpi-coral"><i class="fa-solid fa-flag" aria-hidden="true"></i></span>
            <div>
              <strong id="kpiNeeds">—</strong>
              <span>احتياجات عاجلة</span>
              <small id="kpiTotalOpenNeeds" class="kpi-subtext">من — طلب مفتوح</small>
            </div>
          </article>

        </section>

        <!-- Dashboard View Navigation Tabs -->
        <nav class="dashboard-tabs-nav" aria-label="أقسام لوحة البيانات">
          <button type="button" class="dash-tab-btn active" data-tab="overview">
            <i class="fa-solid fa-chart-line" aria-hidden="true"></i> نظرة عامة
          </button>
          <button type="button" class="dash-tab-btn" data-tab="reports">
            <i class="fa-solid fa-file-invoice" aria-hidden="true"></i> التقارير والإحصائيات
          </button>
          <button type="button" class="dash-tab-btn" data-tab="audit">
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i> سجل الرقابة والنشاط
          </button>
        </nav>

        <!-- ============================================================
           TAB 1: OVERVIEW
      ============================================================ -->
        <section class="dash-tab-pane active" id="tab-overview" role="tabpanel" aria-label="نظرة عامة">

          <div class="dashboard-grid dashboard-grid-top">
            <!-- Inventory Status Breakdown -->
            <article class="dashboard-card inventory-chart-card">
              <div class="dashboard-card-heading">
                <div>
                  <h2>حالة المخزون</h2>
                  <p>توزيع الأصناف حسب حالتها التشغيلية</p>
                </div>
                <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
              </div>
              <div class="inventory-chart" id="inventoryChart" aria-label="رسم حالة المخزون"></div>
            </article>

            <!-- Operational Alerts -->
            <article class="dashboard-card alerts-card">
              <div class="dashboard-card-heading">
                <div>
                  <h2>التنبيهات التشغيلية</h2>
                  <p>عناصر تتطلب تدخلاً ومتابعة فورية</p>
                </div>
                <i class="fa-solid fa-bell" aria-hidden="true"></i>
              </div>
              <div class="alert-list" id="dashboardAlerts"></div>
            </article>
          </div>

          <div class="dashboard-grid dashboard-grid-bottom">
            <!-- Latest Distributions -->
            <article class="dashboard-card table-card">
              <div class="dashboard-card-heading">
                <div>
                  <h2>أحدث التوزيعات الميدانية</h2>
                  <p>آخر عمليات توزيع مسجلة على المستفيدين</p>
                </div>
                <span class="dashboard-count" id="distributionCount">0</span>
              </div>
              <div class="dashboard-table-wrap">
                <table class="dashboard-table">
                  <thead>
                    <tr>
                      <th>رقم العملية</th>
                      <th>المستفيد</th>
                      <th>الحالة</th>
                      <th>التاريخ</th>
                      <th>الأصناف</th>
                    </tr>
                  </thead>
                  <tbody id="distributionRows"></tbody>
                </table>
              </div>
            </article>

            <!-- Urgent Needs -->
            <article class="dashboard-card table-card">
              <div class="dashboard-card-heading">
                <div>
                  <h2>الاحتياجات ذات الأولوية</h2>
                  <p>الطلبات الأكثر إلحاحاً بحاجة لتغطية</p>
                </div>
                <span class="dashboard-count" id="needCount">0</span>
              </div>
              <div class="dashboard-table-wrap">
                <table class="dashboard-table">
                  <thead>
                    <tr>
                      <th>الاحتياج</th>
                      <th>المستفيد</th>
                      <th>الأولوية</th>
                      <th>المتبقي</th>
                    </tr>
                  </thead>
                  <tbody id="needRows"></tbody>
                </table>
              </div>
            </article>
          </div>

          <!-- Recent Donations -->
          <article class="dashboard-card table-card" style="margin-top: 24px;">
            <div class="dashboard-card-heading">
              <div>
                <h2>أحدث التبرعات المستلمة</h2>
                <p>آخر التبرعات المسجلة بالمنصة</p>
              </div>
              <span class="dashboard-count" id="donationCount">0</span>
            </div>
            <div class="dashboard-table-wrap">
              <table class="dashboard-table">
                <thead>
                  <tr>
                    <th>كود التبرع</th>
                    <th>الصنف / التبرع</th>
                    <th>المتبرع</th>
                    <th>الكمية</th>
                    <th>الحالة</th>
                    <th>تاريخ الاستلام</th>
                  </tr>
                </thead>
                <tbody id="donationRows"></tbody>
              </table>
            </div>
          </article>

        </section>

        <!-- ============================================================
           TAB 2: REPORTS & ANALYTICS
      ============================================================ -->
        <section class="dash-tab-pane" id="tab-reports" role="tabpanel" aria-label="التقارير والإحصائيات" hidden>

          <!-- Reports Filter Bar -->
          <section class="dashboard-filters" aria-label="فلاتر التقارير">
            <label>من تاريخ<input id="reportFrom" type="date"></label>
            <label>إلى تاريخ<input id="reportTo" type="date"></label>
            <label>الفئة
              <select id="reportCategory">
                <option value="">جميع الفئات</option>
                <option value="مواد غذائية">مواد غذائية</option>
                <option value="ملابس">ملابس</option>
                <option value="أدوات مدرسية">أدوات مدرسية</option>
                <option value="أثاث">أثاث</option>
                <option value="أجهزة">أجهزة</option>
                <option value="أخرى">أخرى</option>
              </select>
            </label>
            <button class="btn btn-primary" id="applyReportFilters" type="button">
              <i class="fa-solid fa-filter" aria-hidden="true"></i> تطبيق الفلاتر
            </button>
            <button class="btn btn-outline" id="printReportBtn" type="button">
              <i class="fa-solid fa-print" aria-hidden="true"></i> طباعة / تصدير التقرير
            </button>
          </section>

          <!-- Printable Report Header (Visible only when printing) -->
          <div class="print-only-header">
            <h2>سند — تقرير العمليات التشغيلية والاحتياجات</h2>
            <p id="printGeneratedAt"></p>
          </div>

          <div class="dashboard-grid dashboard-grid-top">
            <!-- Donations by Category -->
            <article class="dashboard-card">
              <div class="dashboard-card-heading">
                <div>
                  <h2>التبرعات حسب الفئة</h2>
                  <p>حجم التبرعات العينية حسب التصنيف</p>
                </div>
                <i class="fa-solid fa-shapes" aria-hidden="true"></i>
              </div>
              <div class="report-bar-list" id="donationsCategoryList"></div>
            </article>

            <!-- Needs by Category -->
            <article class="dashboard-card">
              <div class="dashboard-card-heading">
                <div>
                  <h2>أكثر الاحتياجات طلباً</h2>
                  <p>الكميات المطلوبة مقابل الكميات التي تم توفيرها</p>
                </div>
                <i class="fa-solid fa-list-ol" aria-hidden="true"></i>
              </div>
              <div class="report-bar-list" id="needsCategoryList"></div>
            </article>
          </div>

          <div class="dashboard-grid dashboard-grid-bottom" style="margin-top: 24px;">
            <!-- Geographic Distribution by Governorate (Strictly Privacy-Preserving) -->
            <article class="dashboard-card">
              <div class="dashboard-card-heading">
                <div>
                  <h2>التوزيع الجغرافي للمستفيدين</h2>
                  <p>تركز الحالات المسجلة حسب المحافظات (بيانات مجمعة آمنة)</p>
                </div>
                <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
              </div>
              <div class="report-bar-list" id="governorateList"></div>
            </article>

            <!-- Monthly Trend -->
            <article class="dashboard-card">
              <div class="dashboard-card-heading">
                <div>
                  <h2>حركة التوزيع الشهرية</h2>
                  <p>عدد عمليات التوزيع المنفذة خلال الأشهر الماضية</p>
                </div>
                <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
              </div>
              <div class="report-bar-list" id="monthlyTrendList"></div>
            </article>
          </div>

        </section>

        <!-- ============================================================
           TAB 3: AUDIT HISTORY
      ============================================================ -->
        <section class="dash-tab-pane" id="tab-audit" role="tabpanel" aria-label="سجل الرقابة والنشاط" hidden>

          <!-- Audit Filters -->
          <section class="dashboard-filters" aria-label="فلاتر سجل الرقابة">
            <label>نوع الإجراء
              <select id="auditActionFilter">
                <option value="">جميع الإجراءات</option>
                <option value="login_success">تسجيل دخول ناجح</option>
                <option value="inventory_item_created">إضافة صنف مخزني</option>
                <option value="inventory_item_updated">تعديل صنف مخزني</option>
                <option value="beneficiary_created">تسجيل مستفيد جديد</option>
                <option value="beneficiary_verified">اعتماد ملف مستفيد</option>
                <option value="distribution_created">إنشاء أمر توزيع</option>
                <option value="distribution_completed">اكتمال تسليم التوزيع</option>
                <option value="ai_case_note_extracted">استخراج ذكي بالذكاء الاصطناعي</option>
                <option value="recommendation_generated">احتساب توصية الأولوية</option>
                <option value="user_role_updated">تعديل صلاحية مستخدم</option>
              </select>
            </label>
            <button class="btn btn-primary" id="applyAuditFilters" type="button">
              <i class="fa-solid fa-filter" aria-hidden="true"></i> تصفية السجل
            </button>
          </section>

          <article class="dashboard-card table-card">
            <div class="dashboard-card-heading">
              <div>
                <h2>سجل الرقابة وحركات النظام</h2>
                <p>توثيق رسمي وتفصيلي لكافة الإجراءات الحساسة والتغييرات في النظام</p>
              </div>
              <span class="dashboard-count" id="auditCount">0</span>
            </div>
            <div class="dashboard-table-wrap">
              <table class="dashboard-table">
                <thead>
                  <tr>
                    <th>الإجراء</th>
                    <th>المستخدم / الموظف</th>
                    <th>الحالة</th>
                    <th>عنوان IP</th>
                    <th>التوقيت</th>
                  </tr>
                </thead>
                <tbody id="auditRows"></tbody>
              </table>
            </div>
          </article>

        </section>

      </div>
    </main>

    <%- include('../partials/footer') %>

      <!-- Dashboard Controller Scripts -->
      <script src="/JS/dashboard.js"></script>
      <script src="/JS/logout.js"></script>
      <script src="/JS/preferences.js"></script>
</body>

</html>