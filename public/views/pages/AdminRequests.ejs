<!DOCTYPE html>
<% /* EJS page template */ %>
<html lang="ar" dir="rtl">

    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>سند | SANAD — لوحة تحكم الادارة</title>
        <meta name="description" content="طلبات الموافقة — مراجعة طلبات إضافة التبرعات والموافقة عليها أو رفضها." />

        <!-- favicon -->
        <link rel="icon" type="image/png" href="/assets/images/LogoSANAD.png" />

        <!-- fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Cairo:wght@600;700;800&display=swap"
            rel="stylesheet" />

        <!-- font awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

        <!-- styles -->
        <link rel="stylesheet" href="/CSS/style.css" />
    </head>

    <body>
        <a class="skip-link" href="#main-content">تخطي إلى المحتوى الرئيسي</a>

        <!-- scroll progress indicator -->
        <div class="progress-bar" id="progressBar" aria-hidden="true"></div>

        <!-- ============================================================
         NAVBAR
    ============================================================ -->
        <button type="button" class="btn btn-outline admin-sidebar-toggle" id="adminSidebarToggle" aria-expanded="false"
            aria-controls="adminSidebar">
            <i class="fa-solid fa-bars" aria-hidden="true"></i> قائمة الإدارة
        </button>
        <div class="admin-layout" id="adminLayout">
            <aside class="admin-sidebar" id="adminSidebar" aria-label="قائمة الإدارة">
                <div class="admin-sidebar-title"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>إدارة
                        سند</span></div>
                <button type="button" class="admin-sidebar-collapse" id="adminSidebarCollapse"
                    aria-label="طي القائمة الجانبية" aria-expanded="true">
                    <i class="fa-solid fa-angles-right" aria-hidden="true"></i><span>طي القائمة</span>
                </button>
                <div class="admin-theme-control" data-theme-host aria-label="إعدادات المظهر"></div>
                <nav class="admin-sidebar-nav" aria-label="روابط لوحة الإدارة">
                    <a class="admin-sidebar-link" href="/dashboard"><i class="fa-solid fa-gauge-high"
                            aria-hidden="true"></i><span>لوحة الحساب</span></a>
                    <a class="admin-sidebar-link active" href="/admin-requests" aria-current="page"><i
                            class="fa-solid fa-inbox" aria-hidden="true"></i><span>طلبات التبرعات</span></a>
                    <a class="admin-sidebar-link" href="/donations"><i class="fa-solid fa-hand-holding-heart"
                            aria-hidden="true"></i><span>التبرعات</span></a>
                    <a class="admin-sidebar-link" href="/inventory"><i class="fa-solid fa-boxes-stacked"
                            aria-hidden="true"></i><span>المخزون</span></a>
                    <a class="admin-sidebar-link" href="/beneficiaries"><i class="fa-solid fa-people-roof"
                            aria-hidden="true"></i><span>المستفيدون</span></a>
                    <a class="admin-sidebar-link" href="/distributions"><i class="fa-solid fa-truck-fast"
                            aria-hidden="true"></i><span>التوزيعات</span></a>
                </nav>
            </aside>
            <button type="button" class="admin-sidebar-overlay" id="adminSidebarOverlay"
                aria-label="إغلاق قائمة الإدارة"></button>
            <div class="admin-main">
                <main id="main-content">

                    <!-- ============================================================
             PAGE HEADER
        ============================================================ -->
                    <section class="page-hero" id="admin-requests">
                        <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
                        <div class="hero-blob hero-blob-2" aria-hidden="true"></div>

                        <div class="container page-hero-grid">

                            <div class="page-hero-content">
                                <span class="eyebrow reveal"><img src="/assets/images/LogoSANAD.png" alt="logo"
                                        style="width: 50px;">إدارة المنصة</span>
                                <h1 class="page-hero-title reveal">طلبات الموافقة على التبرعات</h1>
                                <p class="page-hero-sub reveal">راجع طلبات إضافة التبرعات المقدمة من المستخدمين ووافق
                                    عليها أو
                                    ارفضها.</p>
                            </div>

                            <div aria-hidden="true">
                                <img src="/assets/images/Donations.png" alt="التبرعات">
                            </div>

                        </div>
                    </section>

                    <!-- ============================================================
             REQUESTS & USERS SECTION
        ============================================================ -->
                    <section class="don-section" aria-label="أقسام الإدارة">
                        <div class="container">

                            <div class="admin-tabs-nav reveal" role="tablist" aria-label="أقسام لوحة الإدارة">
                                <button type="button" class="admin-tab-btn active" id="tabDonationsBtn" role="tab" aria-selected="true" aria-controls="donationsSection">
                                    <i class="fa-solid fa-inbox" aria-hidden="true"></i> طلبات التبرعات
                                </button>
                                <button type="button" class="admin-tab-btn" id="tabUsersBtn" role="tab" aria-selected="false" aria-controls="usersSection">
                                    <i class="fa-solid fa-users-gear" aria-hidden="true"></i> إدارة المستخدمين والأدوار
                                </button>
                            </div>

                            <div id="donationsSection" role="tabpanel">
                                <div class="admin-toolbar reveal">
                                    <div class="admin-toolbar-title">
                                        <i class="fa-solid fa-inbox"></i>
                                        <span>طلبات إضافة التبرعات</span>
                                        <span class="admin-pending-badge" id="pendingCount">0</span>
                                    </div>

                                    <div class="admin-filter">
                                        <i class="fa-solid fa-filter" aria-hidden="true"></i>
                                        <select id="approvalFilter" aria-label="تصفية حالة الطلب">
                                            <option value="all">كل الطلبات</option>
                                            <option value="pending">بانتظار الموافقة</option>
                                            <option value="approved">تمت الموافقة</option>
                                            <option value="rejected">مرفوضة</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="ui-state ui-loading" id="adminLoading" role="status" aria-live="polite"
                                    aria-busy="true">
                                    <i class="fa-solid fa-spinner" aria-hidden="true"></i>
                                    <span data-state-message>جارٍ تحميل طلبات التبرعات…</span>
                                </div>
                                <div class="ui-state ui-error" id="adminError" role="alert" hidden>
                                    <div class="ui-error-content">
                                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                                        <span data-state-message>تعذر تحميل طلبات التبرعات.</span>
                                    </div>
                                    <button type="button" class="btn btn-outline ui-error-retry" data-state-retry>إعادة
                                        المحاولة</button>
                                </div>
                                <div class="admin-card reveal">
                                    <div class="admin-table-wrap">
                                        <table class="dash-table admin-table">
                                            <thead>
                                                <tr>
                                                    <th>معرّف الطلب</th>
                                                    <th>التبرع</th>
                                                    <th>المتبرع</th>
                                                    <th>الفئة</th>
                                                    <th>الكمية</th>
                                                    <th>الحالة</th>
                                                    <th>المخزن / الموقع</th>
                                                    <th>الوصف</th>
                                                    <th>التاريخ</th>
                                                    <th>حالة الطلب</th>
                                                    <th>إجراءات</th>
                                                </tr>
                                            </thead>
                                            <tbody id="adminTableBody">
                                                <!-- rows rendered by admin-requests.js -->
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="don-empty admin-empty" id="adminEmpty" hidden>
                                        <i class="fa-solid fa-inbox"></i>
                                        <h3>لا توجد طلبات مطابقة</h3>
                                        <p>عندما يرسل المستخدمون طلبات إضافة تبرع ستظهر هنا.</p>
                                    </div>
                                </div>
                            </div>

                            <div id="usersSection" role="tabpanel" hidden>
                                <div class="admin-toolbar">
                                    <div class="admin-toolbar-title">
                                        <i class="fa-solid fa-users"></i>
                                        <span>إدارة المستخدمين والأدوار</span>
                                        <span class="admin-pending-badge" id="usersTotalCount">0</span>
                                    </div>

                                    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                                        <div style="position: relative;">
                                            <input type="search" id="userSearchInput" placeholder="بحث بالاسم أو البريد…" class="form-control" style="padding-inline-start: 32px; height: 38px; border-radius: 8px; border: 1px solid var(--border); font-size: 0.9rem; min-width: 220px;" />
                                            <i class="fa-solid fa-magnifying-glass" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;"></i>
                                        </div>
                                        <div class="admin-filter">
                                            <i class="fa-solid fa-filter" aria-hidden="true"></i>
                                            <select id="userRoleFilter" aria-label="تصفية الدور">
                                                <option value="">كل الأدوار</option>
                                                <option value="admin">مدير (Admin)</option>
                                                <option value="donor">متبرع (Donor)</option>
                                                <option value="beneficiary">مستفيد (Beneficiary)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="ui-state ui-loading" id="usersLoading" role="status" aria-live="polite" aria-busy="true">
                                    <i class="fa-solid fa-spinner" aria-hidden="true"></i>
                                    <span data-state-message>جارٍ تحميل بيانات المستخدمين…</span>
                                </div>
                                <div class="ui-state ui-error" id="usersError" role="alert" hidden>
                                    <div class="ui-error-content">
                                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                                        <span data-state-message>تعذر تحميل بيانات المستخدمين.</span>
                                    </div>
                                    <button type="button" class="btn btn-outline ui-error-retry" id="usersRetryBtn">إعادة المحاولة</button>
                                </div>

                                <div class="admin-card">
                                    <div class="admin-table-wrap">
                                        <table class="dash-table admin-table">
                                            <thead>
                                                <tr>
                                                    <th>المعرّف</th>
                                                    <th>الاسم</th>
                                                    <th>البريد الإلكتروني</th>
                                                    <th>الهاتف</th>
                                                    <th>الدور الحالي</th>
                                                    <th>تغيير الدور</th>
                                                    <th>إجراء</th>
                                                </tr>
                                            </thead>
                                            <tbody id="usersTableBody">
                                                <!-- rows rendered by admin-requests.js -->
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="don-empty admin-empty" id="usersEmpty" hidden>
                                        <i class="fa-solid fa-user-slash"></i>
                                        <h3>لا يوجد مستخدمون مطابقون</h3>
                                        <p>جرّب تعديل مصطلح البحث أو فلتر الدور.</p>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </section>

                </main>
            </div>
        </div>

        <!-- ============================================================
         FOOTER
    ============================================================ -->
        <!-- <%- include('../partials/footer') %> -->

        <!-- toast notification -->
        <div class="toast" id="toast" role="status" aria-live="polite">
            <i class="fa-solid fa-circle-info"></i>
            <span></span>
        </div>

        <!-- back to top -->
        <button class="back-to-top" id="backToTop" aria-label="العودة إلى الأعلى">
            <i class="fa-solid fa-arrow-up"></i>
        </button>

        <!-- scripts -->
        <script src="/JS/main.js"></script>
        <script src="/JS/donations-store.js"></script>
        <script src="/JS/ui-states.js"></script>
        <script src="/JS/admin-requests.js"></script>
        <script src="/JS/admin-sidebar.js"></script>
        <script src="/JS/logout.js"></script>

        <script src="/JS/preferences.js"></script>
    </body>

</html>