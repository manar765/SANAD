<!DOCTYPE html>
<html lang="ar" dir="rtl">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>سند — تعيين كلمة مرور جديدة</title>
        <link rel="icon" type="image/png" href="/assets/images/LogoSANAD.png">
        <link rel="stylesheet" href="/CSS/login.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
        <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap"
            rel="stylesheet">
    </head>

    <body>
        <main class="page password-recovery-page">
            <section class="brand-panel">
                <div class="brand-logo"><img src="/assets/images/LogoSANAD.png" alt="شعار سند"></div>
                <h2>أنشئ كلمة مرور جديدة</h2>
                <p class="lead">استخدم كلمة مرور قوية لحماية حسابك وبياناتك على منصة سند.</p>
            </section>
            <section class="form-panel">
                <div class="form-box recovery-box">
                    <a class="back-link" href="/login"><i class="fa-solid fa-arrow-right"></i> العودة لتسجيل الدخول</a>
                    <div class="top-badge"><i class="fa-solid fa-shield-halved"></i> تأمين الحساب</div>
                    <h3>تعيين كلمة مرور جديدة</h3>
                    <p class="sub">يجب ألا تقل كلمة المرور الجديدة عن 8 أحرف.</p>
                    <form id="resetPasswordForm" novalidate>
                        <div class="field-group">
                            <label class="field-label" for="newPassword">كلمة المرور الجديدة</label>
                            <div class="password-input-wrap"><input class="field" id="newPassword" type="password"
                                    autocomplete="new-password" required minlength="8"><button type="button"
                                    class="password-toggle" data-password-toggle="newPassword"
                                    aria-label="إظهار كلمة المرور" title="إظهار كلمة المرور"><i class="fa-solid fa-eye"
                                        aria-hidden="true"></i></button></div>
                        </div>
                        <div class="field-group">
                            <label class="field-label" for="confirmPassword">تأكيد كلمة المرور</label>
                            <div class="password-input-wrap"><input class="field" id="confirmPassword" type="password"
                                    autocomplete="new-password" required><button type="button" class="password-toggle"
                                    data-password-toggle="confirmPassword" aria-label="إظهار كلمة المرور"
                                    title="إظهار كلمة المرور"><i class="fa-solid fa-eye"
                                        aria-hidden="true"></i></button></div>
                        </div>
                        <button type="submit" class="btn btn-primary" id="resetSubmit"><span class="btn-text">حفظ كلمة
                                المرور</span><span class="spinner"></span></button>
                    </form>
                    <div class="form-status" id="resetStatus" role="status" aria-live="polite"></div>
                </div>
            </section>
        </main>
        <script src="/JS/password-toggle.js"></script>
        <script src="/JS/reset-password.js"></script>
        <script src="/JS/preferences.js"></script>
    </body>

</html>