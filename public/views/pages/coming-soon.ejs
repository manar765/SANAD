<% const copy = {
    "/inventory": {
        title: "المخزون",
        description: "تابع التبرعات التي تم استلامها والمخزون المتاح للتوزيع من مكان واحد.",
        icon: "fa-boxes-stacked",
    },
    "/beneficiaries": {
        title: "المستفيدون",
        description: "إدارة بيانات المستفيدين واحتياجاتهم بصورة منظمة وشفافة.",
        icon: "fa-users",
    },
    "/distributions": {
        title: "التوزيعات",
        description: "تابع عمليات توزيع التبرعات وسجل حالة كل عملية.",
        icon: "fa-truck-fast",
    },
}[currentPath] || {
    title: "قسم سند",
    description: "هذا القسم سيكون متاحًا قريبًا ضمن تطويرات منصة سند.",
    icon: "fa-layer-group",
}; %>
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سند — <%= copy.title %></title>
    <link rel="icon" type="image/png" href="/assets/images/LogoSANAD.png">
    <link rel="stylesheet" href="/CSS/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>
    <a class="skip-link" href="#main-content">تخطي إلى المحتوى الرئيسي</a>
    <header class="navbar" id="navbar">
        <div class="container nav-inner">
            <a href="/" class="brand" aria-label="سند — الصفحة الرئيسية">
                <img src="/assets/images/LogoSANAD.png" alt="شعار سند" class="brand-logo">
                <span class="brand-text"><span class="brand-ar">سند</span><span class="brand-en">SANAD</span></span>
            </a>
            <nav class="nav-menu" aria-label="التنقل الرئيسي">
                <div class="nav-links">
                    <a href="/" class="nav-link">الرئيسية</a>
                    <a href="/donations" class="nav-link">التبرعات</a>
                    <a href="/dashboard" class="nav-link">حسابي</a>
                </div>
                <div class="nav-actions">
                    <a href="/login" class="btn btn-logout logout-action" data-logout>تسجيل خروج</a>
                </div>
            </nav>
            <button class="nav-toggle" id="navToggle" aria-label="فتح القائمة" aria-expanded="false">
                <span class="bar"></span><span class="bar"></span><span class="bar"></span>
            </button>
        </div>
    </header>

    <main id="main-content">
        <section class="page-hero">
            <div class="container page-hero-content" style="text-align: center; margin-inline: auto;">
                <span class="eyebrow"><i class="fa-solid <%= copy.icon %>" aria-hidden="true"></i> منصة سند</span>
                <h1 class="page-hero-title"><%= copy.title %></h1>
                <p class="page-hero-sub"><%= copy.description %></p>
                <a href="/donations" class="btn btn-primary">العودة إلى التبرعات</a>
            </div>
        </section>
    </main>

    <script src="/JS/logout.js"></script>
    <script src="/JS/preferences.js"></script>
</body>

</html>
